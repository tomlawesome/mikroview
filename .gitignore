/web/dist/*
!/web/dist/.gitkeep
/frontend/node_modules/
/frontend/dist/
/tools/screenshots/node_modules/
# There is no npm project at the repo root, but a vite/vitest run whose
# base resolves here anyway drops a node_modules/.vite cache. Ignored so
# that stray never reaches a commit.
/node_modules/
/tools/screenshots/mobile-check-out/
/mikroview
/deploy/config.yaml
*.log
# ...except the RouterOS verification transcripts (#894). The CHR exercise
# commits each one beside the dialect row it proves
# (scripts/routeros-chr-open-mr.sh), so they are tracked content, not a
# stray: without this negation that job's `git add` refuses the path and the
# nightly run fails after every part of its real work has succeeded (#1318).
# A negation rather than a forced add, so every other tool agrees the file
# is tracked.
!/docs/routeros-verification-logs/*.log
.DS_Store
# Local agent settings stay out; project skills are shared -- they are
# how the next person (or session) finds the live-check fixture.
.claude/*
!.claude/skills/

# live-check scratch directory (scripts/live-env.sh)
/tmp-live/

# Session handoff snapshots. They are in-flight notes for whoever picks the
# work up next, not repository state -- the issues and PRs are that.
/.agents/

# Parallel-agent worktrees are created here (see AGENTS.md on running agents
# in parallel). They are separate checkouts, not content of this one.
/worktrees/

# The remote gate tees its full run here (scripts/gate-remote.sh). It is a
# 2700-line log of one run, not content.
/gate-run.log

# scripts/fetch-upgrade-fixtures.sh downloads here; scripts/record-
# upgrade-fixture.sh packs here before uploading. A recorded data
# directory holds password/token hashes and a TLS key, made-up or not,
# and gitleaks would flag every one -- see docs/upgrades.md, "How this
# is tested". Never committed.
/.upgrade-fixtures/

# The checksum-verified cosign the signing job installs (#1309,
# scripts/ensure-cosign.sh). A downloaded binary, never committed.
.mv-cosign/
