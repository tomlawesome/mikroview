.git
mikroview
*.log
node_modules
frontend/node_modules
frontend/dist
web/dist/*
!web/dist/index.html
docs/design
# Recorded upgrade fixtures: password/token hashes and a TLS key, never
# committed (.gitignore) and never in a build context either.
.upgrade-fixtures
# Coverage counts from test runs (#1451), never in a build context.
.coverdata
# Trivy's vulnerability database (GitLab cache, #1462), restored in the
# checkout before the build.
.trivy-cache
# CI artefacts written into the checkout (#1472): build:image's saved
# image, security:trivy-image's SBOM, publish:image's evidence. Never part
# of a build context, so a later build cannot carry one image in another.
image.tar
image.spdx.json
.mv-supply-chain
