{
  "//": "test files are not product code and node_modules is third-party; neither is worth reporting clones in",
  "path": ["frontend/src"],
  "format": ["typescript", "javascript"],
  "ignore": ["**/*.test.ts", "**/*.test.js", "**/node_modules/**"],
  "threshold": 3,
  "reporters": ["console", "json"],
  "output": "jscpd-report",
  "gitignore": true,
  "exitCode": 3
}
