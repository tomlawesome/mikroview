{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": [
    "The dependency dashboard is off (owner, 2026-09-10). It is a bot-written issue with no acceptance criteria that never reaches a done state, so it sits in a milestone that can then never report as finished, and it is stale between runs. Turning it off changes nothing about what Renovate watches or raises: the merge requests still arrive. ai/orbit turned it off on 2026-09-08 for the same reason; this matches it."
  ],
  "dependencyDashboard": false,
  "baseBranches": ["dev"],
  "platformAutomerge": false,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "labels": ["type: chore", "area: governance"],
  "commitMessagePrefix": "deps:",
  "branchPrefix": "renovate/",
  "enabledManagers": ["gomod", "npm", "dockerfile", "gitlabci"],
  "ignorePaths": ["**/node_modules/**", "tools/screenshots/**"],
  "gomod": {
    "postUpdateOptions": ["gomodTidy"]
  },
  "packageRules": [
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["gitlabci"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ci images minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ]
}
