{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["dev"],
  "platformAutomerge": false,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "labels": ["type: chore", "area: governance"],
  "commitMessagePrefix": "deps:",
  "branchPrefix": "renovate/",
  "enabledManagers": ["gomod", "npm", "dockerfile", "gitlabci"],
  "ignorePaths": ["**/node_modules/**", "tools/screenshots/**"],
  "gomod": {
    "postUpdateOptions": ["gomodTidy"]
  },
  "packageRules": [
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["gitlabci"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ci images minor and patch"
    },
    {
      "minimumReleaseAge": "7 days",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ]
}
